{
  "expo": {
    "owner": "devfellon",
    "name": "eletricaeart",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ceo",
    "userInterfaceStyle": "automatic",
    "icon": "./src/images/EA/ic_launcher.png",
    "splash": {
      "image": "./src/images/EA/EA-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#044a84"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/images/EA/ic_launcher.png",
        "backgroundColor": "#044a84"
      },
      "package": "com.devfellon.eletricaeart"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./src/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./src/fonts/GodOfThunder.ttf"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/app",
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7a67af58-5ff8-4459-a6b6-f4eee575dc91"
      }
    }
  }
}
